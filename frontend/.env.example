# Dev only: where Vite proxies /api. Must match the API process port (same as PORT=...).
# Default: http://127.0.0.1:3000 (backend npm run dev or docker compose with default ports).
# If you run the API with PORT=3002, set VITE_API_PROXY_TARGET=http://127.0.0.1:3002 or the Story Video <video> preview will fail to load.
# Custom Docker host port: MCQ_SHORTS_PORT=3080 → http://127.0.0.1:3080
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Optional dev: Story / quiz library <video> may load MP4 from this origin (defaults to 127.0.0.1:3000). Set to match PORT= when not 3000.
# VITE_API_ORIGIN=http://127.0.0.1:3002

# Optional: override filenames for “Use test video + audio from assets” (paths under backend/assets/).
# VITE_STORY_DEV_VIDEO_ASSET=S01E04 When Life Gives You Tangerines [1080p] [Multi Sub].mkv
# VITE_STORY_DEV_AUDIO_ASSET=AUDIO-2026-04-09-22-39-06.m4a
