# OpenAI
OPENAI_API_KEY=
# Base URL for the API client (not the chat completions path). Trailing /chat/completions is stripped if present.
OPENAI_URL=

# Dev/staging only: when NODE_ENV is not production, empty per-user OpenAI / YouTube / ElevenLabs fields in Settings
# can be filled from OPENAI_* / YT_* / ELEVENLABS_* env vars. Ignored entirely when NODE_ENV=production (users must configure Settings).
SETTINGS_FALLBACK_FROM_ENV=true
# Optional dev defaults for ElevenLabs (same fallback gate as above)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# YouTube OAuth
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=
YT_REFRESH_TOKEN=

# Instagram (optional)
IG_USERNAME=
IG_PASSWORD=

# Server
PORT=3000
NODE_ENV=production

# Paths
OUTPUT_DIR=./output/videos
CACHE_DIR=./cache
TEMP_DIR=./temp
FONT_FILE=

# AWS — one bucket is enough: set both to the same name, or only S3_USER_UPLOADS_BUCKET (outputs fall back to it).
# If both are empty, the editor still uploads via POST /api/story-video/upload-user-media (files under TEMP_DIR/story-user-media).
# Keys: user-uploads/{userId}/… (browser uploads), story-video/{userId}/{jobId}/… (pipeline).
# Example (directory / S3 Express One Zone bucket): S3_REGION=ap-south-1 and same bucket for both vars:
# S3_USER_UPLOADS_BUCKET=videostorage--aps1-az1--x-s3
# S3_OUTPUT_BUCKET=videostorage--aps1-az1--x-s3
# IAM for directory buckets also needs s3express:CreateSession (SDK uses it for GetObject/PutObject).
S3_REGION=
S3_USER_UPLOADS_BUCKET=
S3_OUTPUT_BUCKET=
# Optional: Lambda names for async workers (API must not render video in-process on Lambda).
VIDEO_WORKER_FUNCTION_NAME=
STORY_VIDEO_WORKER_FUNCTION_NAME=
# Max story-video mutating requests per IP per 15 minutes (create, presign, cancel, retry, edit).
# GET /status, /result, subtitles, and output file are not counted (long jobs poll status freely).
STORY_VIDEO_RATE_LIMIT_MAX=40
# Max automatic pipeline runs per job (worker retries with backoff on transient errors)
STORY_VIDEO_MAX_JOB_ATTEMPTS=3
# Max bytes when downloading story assets from presigned URLs (video/audio/bgm)
STORY_ASSET_MAX_DOWNLOAD_BYTES=4294967296
# After HTTP 403 from S3, try GetObject with server AWS credentials if URL parses as S3 (default on)
STORY_S3_SDK_FALLBACK=true
